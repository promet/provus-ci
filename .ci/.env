#Gen var
#options: acquia/pantheon
HOSTING=

# Pantheon vars
# destination main branch for live site. (Pantheon it's still master)
REMOTE_PROD_BRANCH=master
# PANTHEON SPECIFIC for main push to dev (master) terminus commands.
REMOTE_PROD_ENV=dev
# git branch for develop on source repo
DEVELOP_BRANCH=develop
## Branch to keep multidev (Pantheon Only) - Set to true to not delete multidevs but don't use up your quota!
KEEP_BRANCH=false

#Acquia vars
#Project's git url
REMOTE_GIT_REPO=
